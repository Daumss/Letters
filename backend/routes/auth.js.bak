const express = require('express');
const router = express.Router();
const fs = require('fs');
const path = require('path');
const pool = require('../db'); // pg pool

// 1. 자동 로그인 체크 (이미 쿠키가 있으면 /home으로)
router.get('/check-auth', (req, res) => {
  if (req.cookies.user_session) {
    return res.json({ authenticated: true });
  }
  res.json({ authenticated: false });
});

// 2. 로그인 시도 API
router.post('/login', async (req, res) => {
  const { role, schoolId, gradYear, name, birthdate } = req.body;

  try {
    if (role === 'STUDENT') {
      // 학생 조회 (학교, 졸업년도, 이름)
      const student = await pool.query(
        'SELECT id FROM students WHERE school_id = $1 AND grad_year = $2 AND name = $3',
        [schoolId, gradYear, name]
      );

      if (student.rows.length > 0) {
        // 계정 존재: 쿠키 발급 후 완료
        res.cookie('user_session', `student_${student.rows[0].id}`, { httpOnly: true, maxAge: 315360000000 });
        return res.json({ status: 'SUCCESS' });
      }

      // 계정 없음: 서버 메모리(세션)에 임시 저장 후 동의서 전달
      req.session.pendingUser = { role, schoolId, gradYear, name };
      
    } else if (role === 'TEACHER') {
      // 선생님 조회 (이름, 생년월일)
      const teacher = await pool.query(
        'SELECT id FROM teachers WHERE name = $1 AND birthdate = $2',
        [name, birthdate]
      );

      if (teacher.rows.length > 0) {
        res.cookie('user_session', `teacher_${teacher.rows[0].id}`, { httpOnly: true, maxAge: 315360000000 });
        return res.json({ status: 'SUCCESS' });
      }

      // 계정 없음: 세션에 임시 저장
      req.session.pendingUser = { role, name, birthdate };
    }

    // 약관 텍스트 파일 읽어서 전달
    const termsPath = path.join(__dirname, '../terms.txt');
    const termsText = fs.existsSync(termsPath) ? fs.readFileSync(termsPath, 'utf8') : '개인정보 수집 및 이용 동의서 내용입니다.';

    res.json({ status: 'REQUIRE_CONSENT', terms: termsText });

  } catch (err) {
    console.error(err);
    res.status(500).json({ error: '서버 오류' });
  }
});

// 3. 약관 동의 후 회원가입 & DB 저장 API
router.post('/consent', async (req, res) => {
  const pendingUser = req.session.pendingUser;

  if (!pendingUser) {
    return res.status(400).json({ error: '인증 세션이 만료되었습니다. 다시 시도해 주세요.' });
  }

  try {
    let newId;
    if (pendingUser.role === 'STUDENT') {
      const result = await pool.query(
        'INSERT INTO students (school_id, grad_year, name) VALUES ($1, $2, $3) RETURNING id',
        [pendingUser.schoolId, pendingUser.gradYear, pendingUser.name]
      );
      newId = `student_${result.rows[0].id}`;
    } else {
      const result = await pool.query(
        'INSERT INTO teachers (name, birthdate) VALUES ($1, $2) RETURNING id',
        [pendingUser.name, pendingUser.birthdate]
      );
      newId = `teacher_${result.rows[0].id}`;
    }

    // 메모리 세션 파기 후 영속 쿠키 발급
    req.session.destroy();
    res.cookie('user_session', newId, { httpOnly: true, maxAge: 315360000000 });
    res.json({ status: 'SUCCESS' });

  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'DB 저장 중 오류 발생' });
  }
});

module.exports = router;
